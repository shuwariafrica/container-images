{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>shuwariafrica/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned base images in docker-bake.hcl",
      "managerFilePatterns": ["/^docker-bake\\.hcl$/"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<depName>[a-z0-9./-]+):(?<currentValue>[a-zA-Z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "groupName": "base image digests"
    },
    {
      "description": "sbt is pinned as a version AND a tarball checksum; deriving the second needs postUpgradeTasks, which the hosted app does not run. .github/workflows/update-sbt-pin.yml owns both.",
      "matchPackageNames": ["sbt/sbt"],
      "enabled": false
    }
  ]
}
